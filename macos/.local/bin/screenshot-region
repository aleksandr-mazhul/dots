#!/bin/bash
# Interactive region screenshot: clipboard first, then save ~/screenshots.
# `screencapture -c FILE` does not write FILE; LaunchAgent capture without -c
# also fails (no Screen Recording for file output). Clipboard then dump works.
set -euo pipefail

if [ -z "${HOME:-}" ] || [ -z "${USER:-}" ]; then
  echo "screenshot-region: HOME and USER must be set" >&2
  exit 1
fi
DIR="${HOME}/screenshots"
LOG="${HOME}/Library/Logs/screenshot-region.log"
mkdir -p "$DIR" "$(dirname "$LOG")"

exec >>"$LOG" 2>&1
echo "$(date '+%F %T') start pid=$$"

if ! /usr/sbin/screencapture -i -c -x; then
  echo "$(date '+%F %T') cancelled or failed"
  exit 0
fi

file="${DIR}/Screenshot $(date +'%Y-%m-%d at %H.%M.%S').png"
if ! /usr/bin/osascript <<EOF
set pngData to (the clipboard as «class PNGf»)
set outFile to POSIX file "${file}"
set f to open for access outFile with write permission
set eof of f to 0
write pngData to f
close access f
EOF
then
  echo "$(date '+%F %T') failed writing clipboard PNG to ${file}"
  exit 0
fi

if [[ -s "$file" ]]; then
  echo "$(date '+%F %T') saved ${file} ($(wc -c < "$file" | tr -d ' ') bytes)"
  printf '%s\n' "${file}:$(stat -f %m "$file")" > "${TMPDIR:-/tmp}/screenshot-to-clipboard.last"
else
  echo "$(date '+%F %T') wrote empty ${file}"
  rm -f "$file"
fi
