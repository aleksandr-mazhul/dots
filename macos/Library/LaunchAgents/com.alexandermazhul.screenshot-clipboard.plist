<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexandermazhul.screenshot-clipboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/screenshot-to-clipboard"</string>
  </array>
  <!-- launchd does not expand $HOME. This path is the home directory on this Mac. -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/alexandermazhul/screenshots</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>0</integer>
</dict>
</plist>
