;; Shared Kanata config (macOS + Linux). Stow: common/.config/kanata/kanata.kbd
;; OS-specific bits live in (platform ...) blocks below.
;;
;; Timings (change here → both machines after git pull && ./scripts/sync.sh)
;;   tap-hold-require-prior-idle  120ms   fast typing → letter, skip wait
;;   tap / tap-repress            200ms   double-tap still a letter
;;   hold (tap-hold-release)      220ms   hold this long alone → modifier
;;   chords b/n/m+space            50ms
;;
;; HRM  asdf = ctrl / opt / cmd / shift
;;      jkl; = shift / cmd / opt / ctrl
;;      Permissive hold: mod only if another key is pressed AND released
;;      while HRM is still held.
;;
;; Layers: caps tap=esc hold=hyper | left met=cmd-nav | right alt=symbols
;;         F-row = media; hold repeats, release stops; fn hold = F1-F12; fn tap = Ctrl-Space
;; Emergency exit: Left Ctrl + Space + Escape

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
  log-layer-changes no
  tap-hold-require-prior-idle 120
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  macos-dev-names-exclude (
    "Karabiner DriverKit VirtualHIDKeyboard 1.8.0"
    "Karabiner DriverKit VirtualHIDKeyboard"
  )
  linux-continue-if-no-devs-found yes
  linux-dev-names-exclude (
    "kanata"
    "Kanata"
  )
)

(defvar
  tap 200
  hold 220
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  esc  1    2    3    4    5    6    7    8    9    0    min  eql  bspc
  tab  q    w    e    r    t    y    u    i    o    p    lbrc rbrc bksl
  caps a    s    d    f    g    h    j    k    l    scln apos ret
  lsft 102d z    x    c    v    b    n    m    comm .    /    rsft
  fn   lctl lalt lmet           spc            rmet ralt rctl
  left down up   rght
)

(defalias
  ;; Permissive hold: becomes a mod only if another key is pressed AND
  ;; released while this key is still held. Normal typing (including
  ;; opposite-hand pairs like фг / жи) releases the first key first → letter.
  hra (tap-hold-release $tap $hold a lctl)
  hrs (tap-hold-release $tap $hold s lalt)
  hrd (tap-hold-release $tap $hold d lmet)
  hrf (tap-hold-release $tap $hold f lsft)
  hrj (tap-hold-release $tap $hold j rsft)
  hrk (tap-hold-release $tap $hold k rmet)
  hrl (tap-hold-release $tap $hold l ralt)
  hrsc (tap-hold-release $tap $hold scln rctl)

  cap (tap-hold-press $tap $hold esc (layer-while-held hyper) (require-prior-idle 0))
  lcmd (layer-while-held cmd)
  ropt (layer-while-held symbols)
)

(platform (macos)
  (defvirtualkeys
    v-brup-go   (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-start brightness-up)
    v-brup-stop (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-stop brightness-up)
    v-brdn-go   (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-start brightness-down)
    v-brdn-stop (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-stop brightness-down)
    v-volu-go   (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-start volume-up)
    v-volu-stop (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-stop volume-up)
    v-vold-go   (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-start volume-down)
    v-vold-stop (cmd /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key hold-stop volume-down)
  )
)

(platform (macos)
  (defalias
    k-brup (multi (on-press tap-vkey v-brup-go) (on-release tap-vkey v-brup-stop))
    k-brdn (multi (on-press tap-vkey v-brdn-go) (on-release tap-vkey v-brdn-stop))
    k-volu (multi (on-press tap-vkey v-volu-go) (on-release tap-vkey v-volu-stop))
    k-vold (multi (on-press tap-vkey v-vold-go) (on-release tap-vkey v-vold-stop))
    k-mute (cmd /bin/launchctl asuser 501 /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key mute)
    k-pp   (cmd /bin/launchctl asuser 501 /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key play-pause)
    k-next (cmd /bin/launchctl asuser 501 /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key next)
    k-prev (cmd /bin/launchctl asuser 501 /Users/alexandermazhul/dotfiles/macos/.config/kanata/bin/macos-media-key previous)
    k-mctl (cmd /usr/bin/sudo -u alexandermazhul /usr/bin/open -g -a "Mission Control")
    k-sls  (cmd /usr/bin/sudo -u alexandermazhul /usr/bin/open -g /System/Library/CoreServices/Spotlight.app)
    k-dtn  dtn
    k-dnd  (cmd /usr/bin/sudo -u alexandermazhul /usr/bin/open "raycast://extensions/yakitrak/do-not-disturb/toggle?launchType=background")
    fnl (tap-hold-keys $tap $hold C-spc (layer-while-held fkeys) (hold-on-press f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12))
  )
)

(platform (linux)
  (defalias
    k-brup brup
    k-brdn brdn
    k-volu volu
    k-vold vold
    k-mute mute
    k-pp   pp
    k-next next
    k-prev prev
    k-mctl XX
    k-sls  XX
    k-dtn  XX
    k-dnd  XX
    fnl (tap-hold-keys $tap $hold C-spc (layer-while-held fkeys) (hold-on-press f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12))
  )
)

(deflayer base
  @k-brdn @k-brup @k-mctl @k-sls @k-dtn @k-dnd @k-prev @k-pp @k-next @k-mute @k-vold @k-volu
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @cap @hra @hrs @hrd @hrf _    _    @hrj @hrk @hrl @hrsc _    _
  _    grv  _    _    _    _    _    _    _    _    _    _    _
  @fnl _    _    @lcmd              _              _    @ropt _
  _    _    _    _
)

;; b/n/m + space chords (global in Karabiner, no layer condition)
(defchordsv2
  (b spc) esc 50 all-released ()
  (n spc) tab 50 all-released ()
  (m spc) ret 50 all-released ()
)

;; ---------------------------------------------------------------------------
;; Left Command layer (Karabiner: cmd_layer)
;; Physical left cmd is consumed as the layer key (lazy cmd via explicit M-*).
;; asdf on this layer are hold-only modifiers, matching Karabiner variables.
;; ---------------------------------------------------------------------------
(deflayermap (cmd)
  a lctl
  s lalt
  d lmet
  f lsft

  h    left
  j    down
  k    up
  l    rght
  left left
  down down
  up   up
  rght rght

  scln C-a
  i    C-a  ;; tmux prefix; Kitty maps ctrl+a → send_text \x01
  u    S-M-lbrc
  o    S-M-rbrc
  p    pgdn
  n    S-C-M-4
  esc  A-M-esc

  ;; Unmapped keys in Karabiner still sent Command (lazy left_command)
  q    M-q
  w    M-w
  e    M-e
  r    M-r
  t    M-t
  y    M-y
  g    M-g
  z    M-z
  x    M-x
  c    M-c
  v    M-v
  b    M-b
  m    M-m
  tab  M-tab
  spc  M-spc
  ret  M-ret
  bspc M-bspc
  grv  M-grv
  102d M-grv
  1    M-1
  2    M-2
  3    M-3
  4    M-4
  5    M-5
  6    M-6
  7    M-7
  8    M-8
  9    M-9
  0    M-0
  min  M-min
  eql  M-eql
  lbrc M-lbrc
  rbrc M-rbrc
  apos M-apos
  comm M-comm
  .    M-.
  /    M-/
  bksl M-bksl
)

;; ---------------------------------------------------------------------------
;; Right Option layer (Karabiner: right_opt_layer)
;; ---------------------------------------------------------------------------
(deflayermap (symbols)
  c    min
  a    S-6
  f    S-4
  s    eql
  g    S-8
  d    S-min
  x    S-bksl
  lmet S-eql
  lalt S-7
  2    S-9
  3    S-0
  w    S-apos
  e    apos
  q    S-lbrc
  r    S-rbrc
  tab  S-2
  caps S-3
  lsft S-1
  z    S-comm
  v    S-.
  b    /
  spc  (macro A-spc 20 C-spc)
)

;; ---------------------------------------------------------------------------
