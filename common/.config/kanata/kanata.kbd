;; F-row is media on base. Hold Globe/fn for real F1-F12; tap fn to switch
;; ABC ↔ RussianWin. DriverKit grabs the whole keyboard, so this cannot bypass Kanata.
(deflayermap (fkeys)
  f1  f1
  f2  f2
  f3  f3
  f4  f4
  f5  f5
  f6  f6
  f7  f7
  f8  f8
  f9  f9
  f10 f10
  f11 f11
  f12 f12
)

(deflayermap (hyper)
  b   (layer-while-held hyper-b)
  o   (layer-while-held hyper-o)
  w   (layer-while-held hyper-w)
  s   (layer-while-held hyper-s)
  v   (layer-while-held hyper-v)
  c   (layer-while-held hyper-c)
  r   (layer-while-held hyper-r)
  spc @hy-spc
)

(deflayermap (hyper-b)
  t @hb-t
  p @hb-p
  y @hb-y
  f @hb-f
  r @hb-r
  h @hb-h
)

(deflayermap (hyper-o)
  1 @ho-1
  g @ho-g
  c @ho-c
  v @ho-v
  d @ho-d
  s @ho-s
  e @ho-e
  n @ho-n
  t @ho-t
  h @ho-h
  z @ho-z
  m @ho-m
  r @ho-r
  f @ho-f
  i @ho-i
  p @ho-p
  a @ho-a
  w @ho-w
  l @ho-l
)

(deflayermap (hyper-w)
  scln M-h
  y    @hw-y
  o    @hw-o
  k    @hw-k
  j    @hw-j
  h    @hw-h
  l    @hw-l
  f    @hw-f
  u    C-S-tab
  i    C-tab
  n    M-grv
  b    M-lbrc
  m    M-rbrc
)

(deflayermap (hyper-s)
  u    @k-volu
  j    @k-vold
  i    @k-brup
  k    @k-brdn
  l    C-M-q
  p    @k-pp
  scln @k-next
  e    @hs-e
  d    @hs-d
  t    @hs-t
  c    @hs-c
  v    A-spc
)

(deflayermap (hyper-v)
  h left
  j down
  k up
  l rght
  m C-f
  s C-j
  d S-M-d
  u pgdn
  i pgup
)

(deflayermap (hyper-c)
  p @k-pp
  n @k-next
  b @k-prev
)

(deflayermap (hyper-r)
  1 @hr-1
  2 @hr-2
  c @hr-c
  n @hr-n
  l @hr-l
  e @hr-e
  p @hr-p
  a @hr-a
  s @hr-s
  h @hr-h
)
